---
// Animated "engineering drawing" hero art. The part outline draws itself, then a laser head
// traces it throwing sparks, then an inspection scan sweeps. Pure SVG + one small rAF loop.
interface Props { kind?: string; title?: string; label?: string }
const { kind = 'home', title = 'FLAT PATTERN', label } = Astro.props;

type Draw = { main: string; details: string[]; bends?: string[]; dims: string[]; calls: [number, number, number, number, string][] };

const fins = (() => {
  let d = 'M100,330 H420 V300';
  const n = 8, x0 = 404, w = 12, gap = (300 - n * w) / (n - 1) + w;
  for (let i = 0; i < n; i++) {
    const x = x0 - i * gap;
    d += ` H${x} V120 H${x - w} V300`;
  }
  return d + ' H100 Z';
})();

const blade = (i: number) => {
  const a = (i * Math.PI) / 3, cx = 260, cy = 240;
  const p = (r: number, t: number) => `${(cx + r * Math.cos(t)).toFixed(1)},${(cy + r * Math.sin(t)).toFixed(1)}`;
  return `<path d="M${p(40, a)} Q${p(95, a + 0.55)} ${p(128, a + 0.2)}"/>`;
};

