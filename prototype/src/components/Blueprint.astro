const d = drawings[kind] ?? drawings.home;
---
<div class="bp" data-toolpath data-speed="120" aria-hidden="true">
  <svg viewBox="0 0 520 480" preserveAspectRatio="xMidYMid meet" role="presentation">
    <defs>
      <pattern id={`g-${kind}`} width="20" height="20" patternUnits="userSpaceOnUse"><path d="M20 0H0V20" fill="none" class="bp-grid" /></pattern>
      <filter id="glow" x="-200%" y="-200%" width="500%" height="500%"><feGaussianBlur stdDeviation="3.5" result="b" /><feMerge><feMergeNode in="b" /><feMergeNode in="b" /><feMergeNode in="SourceGraphic" /></feMerge></filter>
      <linearGradient id="scanGrad" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#8fc0a4" stop-opacity="0" /><stop offset=".9" stop-color="#8fc0a4" stop-opacity=".22" /><stop offset="1" stop-color="#c9e6d4" stop-opacity=".9" /></linearGradient>
      <marker id="ar" viewBox="0 0 10 10" refX="5" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0,0 L10,5 L0,10 z" fill="rgba(201,230,212,.6)" /></marker>
    </defs>
    <rect x="0" y="0" width="520" height="480" fill={`url(#g-${kind})`} />
    <path class="bp-frame" d="M10,10 H510 V470 H10 Z M10,28 H22 M498,10 V22 M510,452 H498 M22,470 V458" data-draw style="--dur:1.6s" />
    <rect class="scan" x="12" y="0" width="496" height="46" style="--scan-h: 420px" />
    <path class="part tool-main" d={d.main} data-draw style="--dur:2.6s;--delay:.25s" />
    <g class="detail fade" set:html={d.details.join('')} style="--delay:1.4s" />
    {d.bends?.map((b, i) => <path class="bend fade" d={b} style={`--delay:${1.8 + i * 0.12}s`} />)}
    {d.dims.map((m, i) => <path class="dim fade" d={m} style={`--delay:${2 + i * 0.05}s`} marker-start={i % 3 === 0 ? 'url(#ar)' : undefined} marker-end={i % 3 === 0 ? 'url(#ar)' : undefined} />)}
    {d.calls.map(([x1, y1, x2, y2, t], i) => (
      <g class="fade" style={`--delay:${2.2 + i * 0.18}s`}>
        <path class="dim" d={`M${x1},${y1} L${x2},${y2}`} />
        <circle cx={x1} cy={y1} r="2.2" fill="#c9e6d4" />
        <text class="call-t" x={x2 > 260 ? x2 - 4 : x2 + 4} y={y2 - 6} text-anchor={x2 > 260 ? 'end' : 'start'}>{t}</text>
      </g>
    ))}
    <g class="fade" style="--delay:2.8s">
      <path class="bp-frame" d="M290,420 H510 V470 H290 Z M290,438 H510" />
      <text class="dim-t" x="298" y="433">LUPTON ASSOCIATES</text>
      <text class="dim-t" x="502" y="433" text-anchor="end">REV A</text>
      <text class="dim-t" x="298" y="459">{title.length > 26 ? title.slice(0, 25) + '…' : title}</text>
    </g>
    <g class="sparks" />
    <circle class="head" r="4.5" cx="-20" cy="-20" />
  </svg>
  {label && <span class="bp-label">{label}</span>}
</div>
