---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Blueprint from '../components/Blueprint.astro';
import Marquee from '../components/Marquee.astro';
import ProcessFinder from '../components/ProcessFinder.astro';
import Steps from '../components/Steps.astro';
import CtaBand from '../components/CtaBand.astro';
import Blocks from '../components/Blocks.astro';
import Icon from '../components/Icon.astro';
import PartScene from '../components/PartScene.astro';
import { org, processes } from '../data/site';
import { topCapabilities, capabilityPath } from '../data/capabilities';
import { industries } from '../data/industries';
import { img } from '../lib/images';
import { words } from '../lib/rich';
import { faqSchema, webPageSchema } from '../lib/schema';
import type { Faq } from '../data/types';

const title = 'Custom Metal, Plastic & Electronic Parts to Print | Lupton';
const description =
  'Send the drawing. Lupton matches stamping, sheet metal, machining, castings, molding, harnesses and PCBAs to the shop that fits and gets you a direct quote.';

const faqs: Faq[] = [
  {
    q: 'What does Lupton Associates do?',
    a: 'Lupton Associates helps OEM engineering and sourcing teams get custom metal, plastic, cable and electronic parts made. We review your drawing and requirements, match the part to a manufacturer whose process, certifications and capacity fit, and get you a quote directly from that shop. We have done this since 1969 from Canandaigua, New York, covering the United States, Canada and Mexico.',
  },
  {
    q: 'Does Lupton manufacture the parts?',
    a: 'No. The manufacturers we work with make the parts. Lupton reviews manufacturing fit and moves the project to the right shop; the manufacturer confirms feasibility, capacity, pricing, lead time and terms, and you place the order with the manufacturer.',
  },
  {
    q: 'What processes can you cover?',
    a: 'Short run and progressive die metal stamping, sheet metal fabrication, CNC machining, grinding and EDM, die, graphite, investment and sand casting, aluminum and plastic extrusion, injection molding, structural foam, RIM, rotational molding and thermoforming, wire harnesses and cable assemblies, PCB assembly and box build, and prototyping, domestic or in low-cost regions.',
  },
  {
    q: 'How fast will I hear back?',
    a: `Within ${org.responsePromise}: whether the project appears to fit, what information is still needed, or the recommended next step. That first response is not a quotation.`,
  },
  {
    q: 'What does it cost to use Lupton?',
    a: 'There is no fee to the buyer for Lupton’s review. You buy from the manufacturer at the price the manufacturer quotes. [CONFIRM]',
  },
  {
    q: 'What should I send?',
    a: 'The drawing or model and revision, material, annual volume and release quantity, critical tolerances, finish, secondary operations, testing and documentation needs, and timing. If something is still open, say so. A sketch or sample is enough to start.',
  },
];

const triggers = [
  { k: 'NEW PROGRAM', h: 'You have a model and no supplier', p: 'We pick the process before you pay for tooling, then route it to a shop that can take it from prototype to production.', a: 'How to choose a process', href: '/resources/choose-manufacturing-process-custom-part/' },
  { k: 'SUPPLIER FAILED', h: 'Your current source slipped', p: 'Lead times, quality or capacity went sideways. We build the second-source package and find a shop that can run it.', a: 'Build a second source', href: '/resources/second-source-custom-components/' },
  { k: 'COST-DOWN', h: 'The piece price is too high', p: 'Fab to stamping, metal to plastic, domestic to low-cost region. We price the options on the same drawing.', a: 'Fab vs. stamping break-even', href: '/resources/fabrication-vs-stamping-break-even/' },
  { k: 'LEAD TIME', h: 'Launch is weeks away', p: 'Short run tooling ships in weeks. On a published UTV program: drawing to parts on the welding line in three weeks.', a: 'Short run stamping', href: '/capabilities/metal-stamping/short-run/' },
];

const bentoOrder = ['metal-stamping', 'sheet-metal-fabrication', 'wire-harnesses-cable-assemblies', 'cnc-machining', 'plastic-molding', 'casting', 'electronic-assembly', 'extrusions', 'prototyping', 'low-cost-region-manufacturing'];
const bento = bentoOrder.map((s) => topCapabilities.find((c) => c.slug === s)!);
const photoCards = new Set(['metal-stamping', 'sheet-metal-fabrication', 'wire-harnesses-cable-assemblies', 'electronic-assembly']);
const industryImg: Record<string, string> = { 'data-center': 'thermal-components', medical: 'medical-imaging', 'heavy-truck': 'utv', 'military-aerospace': 'cnc-center', robotics: 'sm-assembly', energy: 'sm-paintline', 'agriculture-heavy-equipment': 'sm-weld' };
---
<Base title={title} description={description} path="/" schema={[webPageSchema('/', title, description), faqSchema(faqs)]}>
  <!-- ───────── HERO ───────── -->
  <section class="hero" data-spotlight>
    <div class="hero-bg" aria-hidden="true">
      <div class="grid-lines"></div>
      <div class="aurora a1"></div><div class="aurora a2"></div><div class="aurora a3"></div>
    </div>
    <div class="spotlight" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow" data-scramble>Custom manufacturing · since 1969</p>
        <h1 class="bw">
          {words('Send the drawing.').map((w, i) => <span class="w" style={`--i:${i}`}>{w + ' '}</span>)}
          <br />
          {words('We’ll find the shop that').map((w, i) => <span class="w" style={`--i:${i + 3}`}>{w + ' '}</span>)}
          <span class="w serif" style="--i:8;color:var(--sage-2)">fits.</span>
        </h1>
        <div class="lede" data-reveal style="--d:700">
          <p>Lupton Associates gets custom parts made for OEMs: <strong>stamping, sheet metal, CNC machining, castings, molding, extrusions, wire harnesses and PCB assemblies</strong>, domestic or low-cost region. We review your drawing, match it to the manufacturer whose process, certifications and capacity fit the part and the volume, and get you a quote from that shop.</p>
        </div>
        <div class="btn-row" data-reveal style="--d:900">
          <a class="btn btn-primary" href="/rfq/" data-magnetic>Send an RFQ <span class="arrow">→</span></a>
          <a class="btn btn-ghost" href={org.bookingUrl} rel="noopener">Book time with our team</a>
        </div>
        <div class="trust" data-reveal style="--d:1100">
          <span>Response within {org.responsePromise}</span>
          <span>US · Canada · Mexico</span>
          <span>Prototype → production</span>
        </div>
      </div>
      <div class="hero-art" data-reveal style="--d:250">
        <span class="ghost" aria-hidden="true">1969</span>
        <Blueprint kind="home" title="ENCLOSURE · FLAT" />
      </div>
    </div>
  </section>

  <Marquee items={processes} />

  <!-- ───────── CAPABILITIES BENTO ───────── -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">What do you need made?</p>
        <h2>Ten processes. <em class="serif">One drawing review.</em></h2>
        <p>Pick the part family. Every page opens with the answer, then lists what to send, the verified specs, and the questions buyers ask most.</p>
      </div>
      <div class="bento" data-stagger>
        {bento.map((c, i) => {
          const pic = photoCards.has(c.slug) ? img(c.image) : undefined;
          const cls = ['card', pic ? 'photo' : '', i < 2 || i > 7 ? 'wide' : ''].join(' ');
          return (
            <a class={cls} href={capabilityPath(c)}>
              {pic && <div class="bgimg"><Image src={pic} alt="" widths={[400, 700]} sizes="(max-width:640px) 92vw, 50vw" loading="lazy" /></div>}
              {pic ? (
                <div class="body">
                  <span class="ico"><Icon name={c.icon} /></span>
                  <h3>{c.name}</h3>
                  <p>{c.short}</p>
                  <span class="go">Explore <i>→</i></span>
                </div>
              ) : (
                <>
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="ico"><Icon name={c.icon} /></span>
                  <h3>{c.name}</h3>
                  <p>{c.short}</p>
                  <span class="go">Explore <i>→</i></span>
                </>
              )}
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <!-- ───────── TRIGGERS ───────── -->
  <section class="section tight">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">A part and a problem</p>
        <h2>Most RFQs start with <em class="serif">something going wrong.</em></h2>
      </div>
      <div class="triggers" data-stagger>
        {triggers.map((t) => (
          <div class="trigger">
            <span class="k">{t.k}</span>
            <h3>{t.h}</h3>
            <p>{t.p}</p>
            <a href={t.href}>{t.a} →</a>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ───────── PART SCENE ───────── -->
  <section class="section" style="padding-bottom:0">
    <div class="wrap"><PartScene /></div>
  </section>

  <!-- ───────── PROCESS FINDER ───────── -->
  <section class="section">
    <div class="wrap"><ProcessFinder /></div>
  </section>

  <!-- ───────── INDUSTRIES (horizontal scroll) ───────── -->
  <section class="hs" aria-label="Industries">
    <div class="hs-sticky">
      <div class="hs-head">
        <div>
          <p class="eyebrow">Industries</p>
          <h2 style="margin:0">Built into <em class="serif">working equipment.</em></h2>
        </div>
        <a class="btn btn-ghost btn-sm" href="/industries/">All industries →</a>
      </div>
      <div class="hs-track">
        {industries.map((ind, i) => {
          const pic = img(industryImg[ind.slug]);
          return (
            <a class="panel" href={`/industries/${ind.slug}/`}>
              {pic && <div class="bgimg"><Image src={pic} alt="" widths={[500, 900]} sizes="460px" loading="lazy" /></div>}
              <span class="n">{String(i + 1).padStart(2, '0')} / {String(industries.length).padStart(2, '0')}</span>
              <div>
                <h3>{ind.name}</h3>
                <p>{ind.short}</p>
                <span class="go">See parts & requirements →</span>
              </div>
            </a>
          );
        })}
      </div>
      <div class="hs-progress" aria-hidden="true"><i></i></div>
    </div>
  </section>

  <!-- ───────── HOW IT WORKS ───────── -->
  <section class="section">
    <div class="wrap"><Steps /></div>
  </section>

  <!-- ───────── PROOF ───────── -->
  <section class="section paper">
    <div class="wrap">
      <div class="sec-head" data-reveal>
        <p class="eyebrow">Published results</p>
        <h2>Numbers we can put our name on.</h2>
        <p>From Lupton’s published case studies and project notes. Your part will have its own numbers; send it and we will run them.</p>
      </div>
      <div class="proof" data-stagger>
        <a class="proof-card" href="/resources/short-run-stamping-part-conversion/">
          <span class="k">Short run stamping conversion</span>
          <span class="big">$2.65 <span class="arrow-to">→</span> $1.45</span>
          <p>A 10,000 pcs/yr turret part moved to short run stamping on a $1,000 tool. About $11,000 a year saved.</p>
        </a>
        <a class="proof-card" href="/capabilities/metal-stamping/short-run/">
          <span class="k">UTV program · 6 stamped parts</span>
          <span class="big">3 weeks</span>
          <p>Drawing to parts on the customer’s welding line. Tooling in two to three weeks.</p>
        </a>
        <a class="proof-card" href="/resources/automated-pharmaceutical-dispensing-machine-structural-frame/">
          <span class="k">Welded frame · pharma equipment</span>
          <span class="big">0.050 in.</span>
          <p>Across diagonal mounting points, with 0.030 in. hole position, ≤1° beam twist, AWS D1.1 welds and powder coat.</p>
        </a>
      </div>
    </div>
  </section>

  <!-- ───────── STORY ───────── -->
  <section class="section">
    <div class="wrap story">
      <div data-reveal>
        <p class="eyebrow">Since 1969</p>
        <h2>A family business that still <em class="serif">reads the print.</em></h2>
        <p class="muted" style="font-size:1.1rem;max-width:52ch">Al Lupton Sr. started in 1969 with a station wagon and a practical approach: understand what the customer needs, then find the right manufacturing fit. The approach has not changed. Our business development team covers the United States, Canada and Mexico from Canandaigua, New York.</p>
        <div class="counters">
          <div><b data-count="1969" data-plain="1">1969</b><span>Founded</span></div>
          <div><b data-count={new Date().getFullYear() - 1969} data-suffix="+">{new Date().getFullYear() - 1969}+</b><span>Years in business</span></div>
          <div><b data-count="3">3</b><span>Countries covered</span></div>
          <div><b data-count="1">1</b><span>Business day to first response</span></div>
        </div>
        <div class="btn-row" style="margin-top:26px"><a class="btn btn-ghost" href="/about/">Meet the team →</a></div>
      </div>
      <div class="vid" data-reveal style="--d:200">
        <video preload="none" playsinline poster="/media/lupton-since-1969-poster.jpg" width="720" height="900" aria-label="Lupton Associates since 1969, 38-second video">
          <source src="/media/lupton-since-1969.mp4" type="video/mp4" />
        </video>
        <button class="play" type="button" aria-label="Play the 38-second Lupton story"><span><svg width="26" height="26" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z" /></svg></span></button>
      </div>
    </div>
  </section>

  <!-- ───────── FACTS + FAQ (AI-citable) ───────── -->
  <section class="section paper">
    <div class="wrap grid-2">
      <div data-reveal>
        <p class="eyebrow">Lupton at a glance</p>
        <h2>The short version.</h2>
        <Blocks type="facts" items={[
          { label: 'Company', value: 'Lupton Associates' },
          { label: 'Founded', value: '1969' },
          { label: 'Headquarters', value: `${org.address.street}, ${org.address.city}, ${org.address.region} ${org.address.postal}` },
          { label: 'Coverage', value: 'United States, Canada and Mexico' },
          { label: 'What we do', value: 'Review custom-part drawings and requirements, match them to a manufacturer whose process, certifications and capacity fit, and get the buyer a direct quote' },
          { label: 'Processes', value: 'Stamping, sheet metal, CNC machining, casting, extrusion, plastic molding, wire harnesses, PCB assembly, prototyping, low-cost region manufacturing' },
          { label: 'First response', value: `Within ${org.responsePromise}` },
          { label: 'Phone', value: org.phone },
        ]} />
      </div>
      <div data-reveal style="--d:150">
        <p class="eyebrow">Questions buyers ask</p>
        <h2>Before you send anything.</h2>
        <Blocks type="faq" faqs={faqs} />
      </div>
    </div>
  </section>

  <CtaBand />
</Base>
