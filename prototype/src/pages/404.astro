---
import Base from '../layouts/Base.astro';
import Blueprint from '../components/Blueprint.astro';
---
<Base title="Page not found | Lupton Associates" description="This page moved. Try capabilities, industries or send an RFQ." path="/404/" noindex>
  <section class="phero">
    <div class="wrap hero-grid">
      <div>
        <p class="eyebrow">404 · out of tolerance</p>
        <h1>This page didn’t make it through inspection.</h1>
        <p class="lede">It may have moved in the redesign. Try one of these, or send the drawing and we will take it from there.</p>
        <div class="btn-row"><a class="btn btn-primary" href="/rfq/">Send an RFQ →</a><a class="btn btn-ghost" href="/capabilities/">Capabilities</a><a class="btn btn-ghost" href="/industries/">Industries</a></div>
      </div>
      <div class="hero-art"><Blueprint kind="stamp" title="SCRAP · REV X" /></div>
    </div>
  </section>
</Base>
